#!/usr/bin/env bash
set -euo pipefail

# Tool install dir (this script + bundled rlog.sh). Project root is separate.
# Resolve symlinks so ~/.local/bin/dssh → …/bin/dssh still finds sibling rlog.sh.
tool_self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s\n' "${BASH_SOURCE[0]}")"
tool_dir="$(cd "$(dirname "$tool_self")" && pwd)"
tool_bin="$tool_dir/$(basename "$tool_self")"

find_project_root() {
  local dir
  if [[ -n "${DSSH_PROJECT_ROOT-}" ]]; then
    (cd "$DSSH_PROJECT_ROOT" && pwd)
    return 0
  fi
  if [[ -n "${DSSH_CONFIG_FILE-}" ]]; then
    (cd "$(dirname "$DSSH_CONFIG_FILE")" && pwd)
    return 0
  fi
  dir="$PWD"
  while true; do
    if [[ -f "$dir/.dsshrc" || -f "$dir/.dsshrc.local" ]]; then
      printf '%s\n' "$dir"
      return 0
    fi
    if [[ "$dir" == "/" ]]; then
      break
    fi
    dir="$(dirname "$dir")"
  done
  # Vendored / wrapper layout: binary lives in the project that has .dsshrc.
  if [[ -f "$tool_dir/.dsshrc" ]]; then
    printf '%s\n' "$tool_dir"
    return 0
  fi
  printf '%s\n' "$PWD"
}

# project_dir = consumer checkout. script_dir kept as alias for legacy call sites.
project_dir="$(find_project_root)"
script_dir="$project_dir"
config_file="${DSSH_CONFIG_FILE:-$project_dir/.dsshrc}"
default_target="${DSSH_DEFAULT_TARGET:-}"

if [[ -f "$config_file" ]]; then
  # shellcheck disable=SC1090
  source "$config_file"
fi

# Local overrides (hosts, keys) — gitignored. Sourced after .dsshrc.
local_config_file="${DSSH_LOCAL_CONFIG_FILE:-$project_dir/.dsshrc.local}"
if [[ -f "$local_config_file" ]]; then
  # shellcheck disable=SC1090
  source "$local_config_file"
fi

csv_split() {
  local raw="${1-}"
  local -a parts=()
  local p
  raw="${raw// /}"
  if [[ -z "$raw" ]]; then
    return 0
  fi
  IFS=',' read -ra parts <<< "$raw"
  for p in "${parts[@]}"; do
    [[ -n "$p" ]] && printf '%s\n' "$p"
  done
}

configured_targets() {
  local raw="${dssh_targets-}"
  if [[ -n "$raw" ]]; then
    csv_split "$raw"
    return 0
  fi
}

resolve_target_alias() {
  local name="$1"
  local t aliases_var aliases a
  while IFS= read -r t; do
    [[ -z "$t" ]] && continue
    if [[ "$t" == "$name" ]]; then
      printf '%s\n' "$t"
      return 0
    fi
    aliases_var="${t}_aliases"
    aliases="${!aliases_var-}"
    while IFS= read -r a; do
      [[ -z "$a" ]] && continue
      if [[ "$a" == "$name" ]]; then
        printf '%s\n' "$t"
        return 0
      fi
    done < <(csv_split "$aliases")
  done < <(configured_targets)
  # Bare path-target still counts even without dssh_targets.
  if [[ -n "${!name-}" ]]; then
    printf '%s\n' "$name"
    return 0
  fi
  printf '%s\n' "$name"
}

usage() {
  cat <<'EOF'
Usage:
  dssh <global-action>
  dssh <target> [build|<action>|<command...>]

Project root is the directory with .dsshrc (walks up from $PWD, or
DSSH_PROJECT_ROOT / DSSH_CONFIG_FILE). The tool binary may live elsewhere.

Mode (dssh_mode in .dsshrc, or DSSH_MODE):
  auto   (default) live if dssh_live_detect_targets containers are compose-owned
  live   force compose prod overlay (files from dssh_live_compose_*)
  local  force dssh docker-run / npm-dev workflow

LIVE (compose prod — container/service names from .dsshrc):
  publish          rolling deploy via dssh_publish_local; starts rlog if off
  status | ps      compose prod services + rlog
  health           containers from dssh_live_health_* + optional HTTP probe
  logs | logs <t>  follow compose service logs
  logs rlog        follow resource logger snapshot (latest.txt)
  <t> logs         same as logs <t>
  rlog [on|off|status]
  migrate          dssh_live_migrate_cmd in dssh_live_migrate_service
  <t> restart      rebuild+replace ONE service (--no-deps); site stays up
  <t> start        same as restart on live (rolling replace)
  <t> stop         stop ONE compose service (brief partial outage)
  <t> migrate      same as global migrate (migrate service only)
  stop --hard      DANGER: stop entire live stack (app + infra services)
  stop             refused on live unless --hard (use <t> stop instead)

REMOTE (from laptop — aliases in .dsshrc):
  rnano <alias>    ssh -t <host> nano <path>  (IdentityFile from rc)
                   optional <alias>_repo → soft-run dssh_env_backup_relpath

LOCAL (dev containers labeled dssh.image):
  stop             stop dssh app containers + compose infra (+ dashboards)
  status | ps      dssh app containers + infra + rlog
  logs | logs <t>  follow dssh start containers
  <t> logs         same as logs <t> (do not pass logs as a container CMD)
  <t> start|restart  rebuild image, then replace that container
  <t> migrate      via target action config
  gpu-setup        install NVIDIA Container Toolkit
  gpu-probe        soft-detect Docker GPU (prints --gpus all|cpu-only; always exits 0)

Examples:
  dssh publish
  dssh status
  dssh health
  dssh logs api
  dssh backend logs
  dssh backend restart
  dssh stop --hard
  dssh backend start
  dssh rnano prod_env

Targets, live services, health probes, and publish/backup paths are all
defined in .dsshrc — see .dsshrc.example in the tool repo.

start/restart always rebuild unless -nobuild / --nobuild.
On live, restart = compose up -d --build --no-deps <service>.
Docker build/stop/run share a lock so two restarts cannot unpack an
image and force-remove a container at the same time.

Optional start/restart preflight (.dsshrc, per target):
  <t>_start_preflight_detect   exit 0 = ok; non-zero = pending step
  <t>_start_preflight_apply    run after y (prompt; default N, 5s timeout)
  <t>_start_preflight_prompt / _timeout / _default

Optional global overrides:
  dssh_stop_local / dssh_status_local / dssh_logs_local / dssh_publish_local
  dssh_mode=auto|live|local

Resource logger (.dsshrc):
  dssh_rlog_containers=<target aliases>
  dssh_rlog_interval=1
  dssh_rlog_dir=./ops/diagnostics
  dssh_gpus=auto|off
EOF
}

append_cli_args() {
  local cmd="$1"
  shift
  if [[ $# -eq 0 ]]; then
    printf '%s\n' "$cmd"
    return
  fi
  local extra
  printf -v extra ' %q' "$@"
  printf '%s\n' "$cmd$extra"
}

use_tty() {
  [[ -t 0 && -t 1 ]]
}

gpu_probe_done=0
gpu_args=()

# Soft-fail GPU discovery for start/restart/publish paths.
# Always returns 0; sets gpu_args=(--gpus all) only after a real attach probe succeeds.
warn_gpu_cpu_fallback() {
  local detail="${1-}"
  echo "dssh: Docker GPU attach failed; continuing cpu-only" >&2
  if [[ -n "$detail" ]]; then
    echo "dssh: $detail" >&2
  fi
  echo "dssh: fix with: $tool_bin gpu-setup   (or set dssh_gpus=off to silence)" >&2
}

gpu_probe_image() {
  if docker image inspect alpine:latest >/dev/null 2>&1; then
    printf '%s\n' "alpine:latest"
    return 0
  fi
  if docker image inspect hello-world:latest >/dev/null 2>&1; then
    printf '%s\n' "hello-world:latest"
    return 0
  fi
  return 1
}

host_nvidia_smi_ok() {
  command -v nvidia-smi >/dev/null 2>&1 || return 1
  nvidia-smi >/dev/null 2>&1
}

docker_has_nvidia_runtime() {
  docker info --format '{{range $k, $v := .Runtimes}}{{println $k}}{{end}}' 2>/dev/null \
    | grep -qx nvidia
}

probe_docker_gpu_attach() {
  local probe_img="$1"
  local err_file rc=1
  err_file="$(mktemp)"
  # alpine supports `true`; hello-world ignores args and still exercises --gpus.
  if docker run --rm --gpus all "$probe_img" true >/dev/null 2>"$err_file"; then
    rm -f "$err_file"
    return 0
  fi
  if docker run --rm --gpus all "$probe_img" >/dev/null 2>"$err_file"; then
    rm -f "$err_file"
    return 0
  fi
  if [[ -s "$err_file" ]]; then
    # One concise line for the caller to surface.
    head -n 1 "$err_file" | tr -d '\r'
  fi
  rm -f "$err_file"
  return 1
}

detect_docker_gpu() {
  # Never abort the caller: every failure mode stays cpu-only with gpu_args=().
  if [[ "$gpu_probe_done" == "1" ]]; then
    return 0
  fi
  gpu_probe_done=1
  gpu_args=()
  case "${dssh_gpus-auto}" in
    0|off|false|no) return 0 ;;
  esac

  local host_gpu=0
  local has_runtime=0
  local probe_img=""
  local probe_detail=""

  if host_nvidia_smi_ok; then
    host_gpu=1
  fi
  if docker_has_nvidia_runtime; then
    has_runtime=1
  fi

  # No GPU signal at all → silent cpu-only.
  if [[ "$host_gpu" != "1" && "$has_runtime" != "1" ]]; then
    return 0
  fi

  if ! probe_img="$(gpu_probe_image)"; then
    warn_gpu_cpu_fallback "no local alpine/hello-world image to probe GPU attach"
    return 0
  fi

  # Require a real --gpus attach. Do not trust runtime registration alone:
  # after kernel upgrades, nvidia runtime can remain registered while vendor
  # discovery / device nodes fail, and docker run --gpus all would crash start.
  if probe_detail="$(probe_docker_gpu_attach "$probe_img")"; then
    gpu_args=(--gpus all)
    return 0
  fi

  if [[ "$host_gpu" == "1" && "$has_runtime" != "1" ]]; then
    echo "dssh: host GPU is up, but Docker has no working nvidia runtime; continuing cpu-only" >&2
    echo "dssh: install toolkit with: $tool_bin gpu-setup" >&2
    if [[ -n "$probe_detail" ]]; then
      echo "dssh: $probe_detail" >&2
    fi
    return 0
  fi

  warn_gpu_cpu_fallback "${probe_detail:-vendor/device discovery failed}"
  return 0
}

disable_docker_gpu() {
  gpu_args=()
  gpu_probe_done=1
}

gpu_setup() {
  local list_url="https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list"
  local key_url="https://nvidia.github.io/libnvidia-container/gpgkey"
  local keyring="/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg"
  local list_file="/etc/apt/sources.list.d/nvidia-container-toolkit.list"

  # Setup itself may fail loudly — only discovery during start/restart is soft.
  if ! host_nvidia_smi_ok; then
    echo "nvidia-smi is not working on the host yet. Enroll the NVIDIA MOK / load the driver first." >&2
    return 1
  fi

  if ! sudo -n true 2>/dev/null && [[ ! -t 0 ]]; then
    echo "gpu-setup needs sudo in a real terminal (this session has no TTY):" >&2
    echo "  $tool_bin gpu-setup" >&2
    return 1
  fi

  echo "Installing NVIDIA Container Toolkit (sudo)..."
  if [[ ! -f "$keyring" ]]; then
    curl -fsSL "$key_url" | sudo gpg --dearmor -o "$keyring"
  fi
  curl -fsSL "$list_url" \
    | sed "s#deb https://#deb [signed-by=$keyring] https://#g" \
    | sudo tee "$list_file" >/dev/null
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y nvidia-container-toolkit
  sudo nvidia-ctk runtime configure --runtime=docker
  sudo systemctl restart docker
  gpu_probe_done=0
  detect_docker_gpu
  if [[ ${#gpu_args[@]} -eq 0 ]]; then
    echo "Toolkit installed, but Docker could not attach the GPU yet." >&2
    echo "Try: docker run --rm --gpus all alpine:latest nvidia-smi" >&2
    return 1
  fi
  echo "dssh GPU ready  (--gpus all)"
  docker run --rm --gpus all alpine:latest nvidia-smi -L 2>/dev/null \
    || docker run --rm --gpus all hello-world:latest >/dev/null
}

detect_shell() {
  local image_name="$1"

  if docker run --rm "$image_name" sh -lc 'command -v bash >/dev/null 2>&1'; then
    printf '%s\n' bash
  else
    printf '%s\n' sh
  fi
}

resolve_path() {
  local path="$1"
  if [[ "$path" == /* ]]; then
    printf '%s\n' "$path"
  else
    (cd "$script_dir" && cd "$path" && pwd)
  fi
}

sanitize_docker_name() {
  local raw="$1"
  raw="${raw#@}"
  raw="${raw//\//-}"
  local cleaned
  cleaned="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9_.-' '-')"
  cleaned="${cleaned#-}"
  cleaned="${cleaned%-}"
  if [[ -z "$cleaned" ]]; then
    cleaned="app"
  fi
  printf '%s\n' "$cleaned"
}

read_package_json_name() {
  local pkg="$1/package.json"
  if [[ ! -f "$pkg" ]]; then
    return 1
  fi
  local name
  name="$(sed -n 's/^[[:space:]]*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$pkg" | head -n1)"
  if [[ -z "$name" ]]; then
    return 1
  fi
  printf '%s\n' "$name"
}

derive_app_name() {
  local target="$1"
  local override_var="${target}_name"
  if [[ -n "${!override_var-}" ]]; then
    sanitize_docker_name "${!override_var}"
    return 0
  fi

  local path="${!target-}"
  if [[ -z "$path" ]]; then
    if [[ -d "$script_dir/$target" ]]; then
      path="$target"
    else
      echo "Unknown target: $target" >&2
      return 1
    fi
  fi

  local abs
  abs="$(resolve_path "$path")"
  local pkg_name
  if pkg_name="$(read_package_json_name "$abs")"; then
    sanitize_docker_name "$pkg_name"
    return 0
  fi

  local rel="${abs#"$script_dir"/}"
  sanitize_docker_name "$rel"
}

container_name_for() {
  local app="$1"
  local action="$2"
  if [[ "$action" == "start" ]]; then
    printf '%s\n' "$app"
  else
    printf '%s\n' "$app-$action"
  fi
}

dssh_app_ids() {
  docker ps -aq --filter "label=dssh.image"
}

# Overlay unpack and container unmount share a dockerd lock. Overlapping
# `docker build` with `docker rm -f` is what wedged the daemon (runc kill
# spinning at 100%, inspect leak, reboot). One flock for all graph mutations
# across every checkout, plus rlog inspect/stats.
docker_lock_held=0
dssh_docker_lock_path() {
  printf '%s\n' "${XDG_RUNTIME_DIR:-/tmp}/dssh-docker.lock"
}

acquire_docker_lock() {
  local lock
  lock="$(dssh_docker_lock_path)"
  if [[ "$docker_lock_held" == "1" ]]; then
    return 0
  fi
  exec 9>>"$lock"
  if ! flock -n 9; then
    echo "Waiting for another dssh docker operation to finish..." >&2
    flock 9
  fi
  docker_lock_held=1
}

remove_container() {
  local name="$1"
  acquire_docker_lock
  if ! docker inspect --type container "$name" >/dev/null 2>&1; then
    return 0
  fi
  # Graceful stop first. rm -f / SIGKILL is what spun runc kill on api.
  if command -v timeout >/dev/null 2>&1; then
    timeout -k 2 12 docker stop -t 8 "$name" >/dev/null 2>&1 || true
  else
    docker stop -t 8 "$name" >/dev/null 2>&1 || true
  fi
  docker rm "$name" >/dev/null 2>&1 || docker rm -f "$name" >/dev/null 2>&1 || true
}

stop_target_start_container() {
  local app="$1"
  local target="$2"
  local old="dssh-${target}-start"
  local stopped=0

  if docker inspect --type container "$app" >/dev/null 2>&1; then
    remove_container "$app"
    echo "Stopped $app."
    stopped=1
  fi
  if [[ "$old" != "$app" ]] && docker inspect --type container "$old" >/dev/null 2>&1; then
    remove_container "$old"
    echo "Stopped $old."
    stopped=1
  fi
  if [[ "$stopped" -eq 0 ]]; then
    echo "$app was not running."
  fi
}

parse_workdir() {
  local dockerfile_path="$1"
  awk 'BEGIN { workdir = "" } toupper($1) == "WORKDIR" { workdir = $2 } END { print workdir }' "$dockerfile_path" | tr -d '\r'
}

host_user_spec() {
  printf '%s:%s\n' "$(id -u)" "$(id -g)"
}

is_root_user_spec() {
  local spec="$1"
  [[ "$spec" == "root" || "$spec" == "0" || "$spec" == "0:0" ]]
}

container_user_spec() {
  local target="${1-}"
  if [[ -n "$target" ]]; then
    local user_var="${target}_user"
    if [[ -n "${!user_var-}" ]]; then
      printf '%s\n' "${!user_var}"
      return 0
    fi
  fi
  host_user_spec
}

build_image() {
  local image_name="$1"
  local dockerfile_path="$2"
  local context_path="$3"
  shift 3

  acquire_docker_lock
  docker build "$@" -f "$dockerfile_path" -t "$image_name" "$context_path"
}

seed_node_modules_volume() {
  local image_name="$1"
  local volume_name="$2"
  local image_id
  local host_spec
  host_spec="$(host_user_spec)"

  image_id="$(docker image inspect -f '{{.Id}}' "$image_name")"

  if ! docker volume inspect "$volume_name" >/dev/null 2>&1; then
    docker volume create "$volume_name" >/dev/null
  fi

  # Require .bin as well as the image-id stamp. A crashed copy used to write the
  # stamp anyway (no set -e), so the next start skipped reseed and apps died
  # with "next: not found" — which then wedged docker inspect / rlog.
  if ! docker run --rm -v "$volume_name:/node_modules" "$image_name" sh -lc "test -f /node_modules/.dssh-image-id && [ \"\$(cat /node_modules/.dssh-image-id)\" = '$image_id' ] && test -d /node_modules/.bin" >/dev/null 2>&1; then
    echo "Seeding $volume_name from $image_name..."
    docker run --rm -v "$volume_name:/node_modules" "$image_name" sh -lc "set -e; rm -rf /node_modules/* /node_modules/.[!.]* /node_modules/..?* 2>/dev/null || true; cp -a /app/node_modules/. /node_modules/; echo '$image_id' > /node_modules/.dssh-image-id"
  fi

  docker run --rm -v "$volume_name:/node_modules" "$image_name" sh -lc "chown -R $host_spec /node_modules"
}

run_container() {
  local image_name="$1"
  local context_path="$2"
  local workdir_path="$3"
  local interactive="$4"
  local container_name="$5"
  local mount_node_modules="$6"
  local detached="$7"
  shift 7
  local env_args=()
  local node_modules_volume="dssh-${image_name//[^a-zA-Z0-9_.-]/-}-node_modules"

  acquire_docker_lock

  if [[ -f "$script_dir/.env" ]]; then
    env_args+=(--env-file "$script_dir/.env")
  fi

  if [[ "$mount_node_modules" == "1" ]]; then
    seed_node_modules_volume "$image_name" "$node_modules_volume"
  fi

  detect_docker_gpu

  local run_args=(--rm)
  local used_gpu=0
  if [[ ${#gpu_args[@]} -gt 0 ]]; then
    run_args+=("${gpu_args[@]}")
    used_gpu=1
  fi
  if [[ "$detached" == "1" ]]; then
    run_args+=(-d)
  elif [[ "$interactive" == "1" ]] && use_tty; then
    run_args+=(-it)
  fi
  if [[ -n "$container_name" ]]; then
    run_args+=(--name "$container_name")
  fi
  local container_user
  container_user="$(container_user_spec "${target_name-}")"
  run_args+=(-u "$container_user")
  if ! is_root_user_spec "$container_user"; then
    env_args+=(-e "HOME=/tmp" -e "npm_config_cache=/tmp/npm-cache")
  fi
  run_args+=(--label "dssh.image=$image_name")
  if [[ -n "${target_name-}" ]]; then
    run_args+=(--label "dssh.target=$target_name")
  fi
  if [[ -n "${app_name-}" ]]; then
    run_args+=(--label "dssh.app=$app_name")
  fi
  if [[ -n "${action_name-}" ]]; then
    run_args+=(--label "dssh.action=$action_name")
  fi

  local mount_args=(
    -v "$context_path:$workdir_path"
  )
  if [[ "$mount_node_modules" == "1" ]]; then
    mount_args+=(-v "$node_modules_volume:$workdir_path/node_modules")
  fi

  local rc=0
  set +e
  docker run "${run_args[@]}" \
    --network host \
    "${env_args[@]}" \
    "${mount_args[@]}" \
    -w "$workdir_path" \
    "$image_name" \
    "$@"
  rc=$?
  set -e
  if [[ $rc -eq 0 || "$used_gpu" != "1" ]]; then
    return "$rc"
  fi

  # --gpus was set and docker run failed. Re-probe so a normal app exit is not
  # masked; only soft-retry cpu-only when attach itself is broken.
  local probe_img="" probe_detail=""
  if ! probe_img="$(gpu_probe_image)"; then
    return "$rc"
  fi
  if probe_detail="$(probe_docker_gpu_attach "$probe_img")"; then
    return "$rc"
  fi

  warn_gpu_cpu_fallback "${probe_detail:-docker run --gpus failed at container start}"
  disable_docker_gpu
  local cpu_args=()
  local i=0
  while [[ $i -lt ${#run_args[@]} ]]; do
    if [[ "${run_args[$i]}" == "--gpus" ]]; then
      i=$((i + 2))
      continue
    fi
    cpu_args+=("${run_args[$i]}")
    i=$((i + 1))
  done
  docker run "${cpu_args[@]}" \
    --network host \
    "${env_args[@]}" \
    "${mount_args[@]}" \
    -w "$workdir_path" \
    "$image_name" \
    "$@"
}

run_container_shell() {
  local image_name="$1"
  local context_path="$2"
  local workdir_path="$3"
  local interactive="$4"
  local container_name="$5"
  local mount_node_modules="$6"
  local detached="$7"
  local shell_cmd="$8"

  run_container "$image_name" "$context_path" "$workdir_path" "$interactive" "$container_name" "$mount_node_modules" "$detached" bash -lc "$shell_cmd"
}

run_local_shell() {
  local shell_cmd="$1"
  local root
  printf -v root '%q' "$script_dir"
  bash -lc "cd $root && $shell_cmd"
}

# Start/restart optional preflight (.dsshrc):
#   <target>_start_preflight_detect   host cmd; exit 0 = nothing to do, non-zero = pending
#   <target>_start_preflight_apply    host cmd; runs only after y confirmation
#   <target>_start_preflight_prompt   text (default: generic pending-step prompt)
#   <target>_start_preflight_timeout  seconds (default 5)
#   <target>_start_preflight_default  N|Y (default N)
# No detect/apply → start/restart unchanged. Stack-specific cmds belong in .dsshrc.
prompt_yn_with_timeout() {
  local prompt="$1"
  local timeout_sec="${2:-5}"
  local default_ans="${3:-N}"
  local reply=""
  local timed_out=0

  printf '%s ' "$prompt" >&2
  if [[ -t 0 ]]; then
    if ! read -r -t "$timeout_sec" reply; then
      timed_out=1
      reply=""
      printf '\n' >&2
    fi
  else
    # Piped/non-TTY: one line if present quickly, else default (smoke / CI).
    if ! read -r -t 0.2 reply; then
      timed_out=1
      reply=""
      printf '\n' >&2
    fi
  fi

  if [[ -z "$reply" ]]; then
    reply="$default_ans"
    if [[ "$timed_out" == "1" ]]; then
      echo "(timeout ${timeout_sec}s → ${default_ans})" >&2
    fi
  fi

  case "$(printf '%s' "$reply" | tr '[:upper:]' '[:lower:]')" in
    y|yes) return 0 ;;
    *) return 1 ;;
  esac
}

maybe_run_start_preflight() {
  local target="$1"
  local detect_var="${target}_start_preflight_detect"
  local apply_var="${target}_start_preflight_apply"
  local prompt_var="${target}_start_preflight_prompt"
  local timeout_var="${target}_start_preflight_timeout"
  local default_var="${target}_start_preflight_default"
  local detect="${!detect_var-}"
  local apply="${!apply_var-}"
  local prompt timeout_sec default_ans detect_rc

  if [[ -z "$detect" || -z "$apply" ]]; then
    return 0
  fi

  prompt="${!prompt_var:-Detected a pending step. Run it now? (y/N)}"
  timeout_sec="${!timeout_var:-5}"
  default_ans="${!default_var:-N}"

  set +e
  run_local_shell "$detect" >/dev/null 2>&1
  detect_rc=$?
  set -e

  if [[ "$detect_rc" -eq 0 ]]; then
    return 0
  fi

  if ! prompt_yn_with_timeout "$prompt" "$timeout_sec" "$default_ans"; then
    echo "Skipping pending step; continuing start." >&2
    return 0
  fi

  echo "Running pending step..." >&2
  run_local_shell "$apply"
}

compose() {
  docker compose --project-directory "$script_dir" "$@"
}

live_compose_file() {
  local rel="${dssh_live_compose_file:-docker-compose.yml}"
  if [[ "$rel" == /* ]]; then
    printf '%s\n' "$rel"
  else
    printf '%s\n' "$script_dir/$rel"
  fi
}

live_compose_prod_file() {
  local rel="${dssh_live_compose_prod_file:-docker-compose.prod.yml}"
  if [[ "$rel" == /* ]]; then
    printf '%s\n' "$rel"
  else
    printf '%s\n' "$script_dir/$rel"
  fi
}

compose_live() {
  docker compose --project-directory "$script_dir" \
    -f "$(live_compose_file)" \
    -f "$(live_compose_prod_file)" \
    "$@"
}

# auto|live|local — live when compose owns dssh_live_detect_targets containers.
dssh_mode_value() {
  local mode="${DSSH_MODE:-${dssh_mode:-auto}}"
  printf '%s\n' "$mode" | tr '[:upper:]' '[:lower:]'
}

container_compose_service() {
  local name="$1"
  docker inspect --type container -f '{{index .Config.Labels "com.docker.compose.service"}}' "$name" 2>/dev/null || true
}

live_app_service_list() {
  local raw="${dssh_live_app_services-}"
  if [[ -z "$raw" ]]; then
    return 0
  fi
  csv_split "$raw"
}

live_infra_service_list() {
  local raw="${dssh_live_infra_services-}"
  if [[ -z "$raw" ]]; then
    return 0
  fi
  csv_split "$raw"
}

# Target alias or compose-ish name → prod compose service (from .dsshrc).
live_compose_service() {
  local target="$1"
  local canon svc_var svc item
  canon="$(resolve_target_alias "$target")"
  svc_var="${canon}_service"
  svc="${!svc_var-}"
  if [[ -n "$svc" ]]; then
    printf '%s\n' "$svc"
    return 0
  fi
  while IFS= read -r item; do
    [[ -z "$item" ]] && continue
    if [[ "$item" == "$target" || "$item" == "$canon" ]]; then
      printf '%s\n' "$item"
      return 0
    fi
  done < <(live_app_service_list; live_infra_service_list)
  return 1
}

# Compose service → running container name (target _name, else prefix+service).
container_for_compose_service() {
  local svc="$1"
  local t svc_var name_var
  while IFS= read -r t; do
    [[ -z "$t" ]] && continue
    svc_var="${t}_service"
    if [[ "${!svc_var-}" == "$svc" ]]; then
      name_var="${t}_name"
      if [[ -n "${!name_var-}" ]]; then
        printf '%s\n' "${!name_var}"
        return 0
      fi
      break
    fi
  done < <(configured_targets)
  printf '%s%s\n' "${dssh_live_container_prefix-}" "$svc"
}

live_container_name() {
  local target="$1"
  local canon name_var svc
  canon="$(resolve_target_alias "$target")"
  name_var="${canon}_name"
  if [[ -n "${!name_var-}" ]]; then
    printf '%s\n' "${!name_var}"
    return 0
  fi
  svc="$(live_compose_service "$target")" || return 1
  container_for_compose_service "$svc"
}

is_live_stack() {
  case "$(dssh_mode_value)" in
    live|prod) return 0 ;;
    local|dev) return 1 ;;
  esac
  local detect="${dssh_live_detect_targets-}"
  local t c svc
  if [[ -z "$detect" ]]; then
    return 1
  fi
  while IFS= read -r t; do
    [[ -z "$t" ]] && continue
    c="$(live_container_name "$t" 2>/dev/null || true)"
    [[ -z "$c" ]] && continue
    svc="$(container_compose_service "$c")"
    if [[ -n "$svc" ]]; then
      return 0
    fi
  done < <(csv_split "$detect")
  return 1
}

live_migrate() {
  local svc="${dssh_live_migrate_service-}"
  local cmd="${dssh_live_migrate_cmd-}"
  if [[ -z "$svc" || -z "$cmd" ]]; then
    echo "live migrate: set dssh_live_migrate_service and dssh_live_migrate_cmd in .dsshrc" >&2
    return 1
  fi
  acquire_docker_lock
  echo "live migrate: $svc (--no-deps)..."
  compose_live run --rm --no-deps "$svc" sh -lc "$cmd"
}

# Rebuild (optional) then replace one compose service; others keep running.
live_restart_service() {
  local svc="$1"
  local skip_build="${2:-0}"
  acquire_docker_lock
  if [[ "$skip_build" == "1" ]]; then
    echo "live: replacing $svc (--no-deps, no rebuild)..."
    compose_live up -d --no-deps --no-build "$svc"
  else
    echo "live: rebuilding+replacing $svc (--no-deps; other services stay up)..."
    compose_live up -d --build --no-deps "$svc"
  fi
}

live_stop_service() {
  local svc="$1"
  acquire_docker_lock
  echo "live: stopping compose service $svc (partial outage until restarted)..."
  compose_live stop "$svc"
}

live_stop_hard() {
  local -a services=()
  local item
  while IFS= read -r item; do
    [[ -n "$item" ]] && services+=("$item")
  done < <(live_app_service_list; live_infra_service_list)
  if [[ ${#services[@]} -eq 0 ]]; then
    echo "live stop --hard: set dssh_live_app_services / dssh_live_infra_services in .dsshrc" >&2
    return 1
  fi
  acquire_docker_lock
  echo "DANGER: stopping entire live stack (${services[*]})..." >&2
  compose_live stop "${services[@]}"
  echo "Live stack stopped. Bring back with: dssh publish"
}

show_live_status() {
  echo "=== mode: live (compose prod) ==="
  compose_live ps
  echo
  echo "=== resource logger ==="
  rlog_status
}

show_local_status() {
  echo "=== mode: local (dssh containers) ==="
  echo "=== dssh app containers ==="
  docker ps --filter "label=dssh.image" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
  echo
  echo "=== compose infra services ==="
  compose --profile dashboards ps postgres redis opensearch opensearch-dashboards 2>/dev/null \
    || compose ps
  echo
  echo "=== resource logger ==="
  rlog_status
  echo
  echo "=== gpu ==="
  gpu_probe_done=0
  detect_docker_gpu
  if [[ ${#gpu_args[@]} -gt 0 ]]; then
    echo "dssh docker: --gpus all"
  elif host_nvidia_smi_ok || docker_has_nvidia_runtime; then
    echo "dssh docker: cpu-only (GPU visible on host but Docker attach failed; try: $tool_bin gpu-setup)"
  else
    echo "dssh docker: cpu-only"
  fi
}

show_status() {
  if is_live_stack; then
    show_live_status
  else
    show_local_status
  fi
}

live_health_container_list() {
  local raw="${dssh_live_health_containers-}"
  local item svc
  if [[ -n "$raw" ]]; then
    csv_split "$raw"
    return 0
  fi
  # Default: resolve infra then app compose services → container names.
  while IFS= read -r svc; do
    [[ -z "$svc" ]] && continue
    container_for_compose_service "$svc"
  done < <(live_infra_service_list; live_app_service_list)
}

live_health() {
  local c st code url url_http exec_c exec_url
  echo "=== live health ==="
  while IFS= read -r c; do
    [[ -z "$c" ]] && continue
    if ! docker inspect --type container "$c" >/dev/null 2>&1; then
      printf '  %-22s %s\n' "$c" "missing"
      continue
    fi
    st="$(docker inspect --type container -f '{{.State.Status}}' "$c" 2>/dev/null || echo unknown)"
    printf '  %-22s %s\n' "$c" "$st"
  done < <(live_health_container_list)
  echo
  url="${dssh_live_health_url-}"
  url_http="${dssh_live_health_url_http-}"
  exec_c="${dssh_live_health_exec_container-}"
  exec_url="${dssh_live_health_exec_url-}"
  if [[ -z "$url" && -z "$exec_c" ]]; then
    echo "(no dssh_live_health_url / dssh_live_health_exec_container configured)"
    return 0
  fi
  code=""
  if [[ -n "$url" ]] && command -v curl >/dev/null 2>&1; then
    code="$(curl -sk -o /dev/null -w '%{http_code}' --connect-timeout 2 --max-time 5 \
      "$url" 2>/dev/null || true)"
    if [[ -z "$code" || "$code" == "000" ]] && [[ -n "$url_http" ]]; then
      code="$(curl -s -o /dev/null -w '%{http_code}' --connect-timeout 2 --max-time 5 \
        "$url_http" 2>/dev/null || true)"
    fi
  fi
  if [[ -n "$code" && "$code" != "000" ]]; then
    echo "GET ${url:-health} → HTTP $code"
  elif [[ -n "$exec_c" ]] && docker inspect --type container "$exec_c" >/dev/null 2>&1; then
    echo -n "GET ${exec_url:-health} (via $exec_c): "
    docker exec "$exec_c" wget -qO- "${exec_url}" 2>/dev/null \
      || docker exec "$exec_c" sh -lc "command -v curl >/dev/null && curl -s $(printf '%q' "$exec_url")" \
      || echo "unreachable"
    echo
  else
    echo "GET health → skipped (no curl / no exec container)"
  fi
}

follow_live_logs() {
  local target="${1-}"
  local svc
  local -a apps=()
  if [[ -z "$target" ]]; then
    while IFS= read -r svc; do
      [[ -n "$svc" ]] && apps+=("$svc")
    done < <(live_app_service_list)
    if [[ ${#apps[@]} -eq 0 ]]; then
      echo "follow logs: set dssh_live_app_services in .dsshrc" >&2
      return 1
    fi
    compose_live logs -f --tail=200 "${apps[@]}"
    return 0
  fi
  if svc="$(live_compose_service "$target")"; then
    compose_live logs -f --tail=200 "$svc"
    return 0
  fi
  docker logs -f "$(derive_app_name "$target")"
}

follow_rlog_logs() {
  local dir latest
  dir="$(rlog_dir)"
  latest="$dir/latest.txt"
  if [[ ! -f "$latest" ]]; then
    echo "No rlog snapshot at $latest (start with: dssh rlog on)." >&2
    return 1
  fi
  if command -v watch >/dev/null 2>&1; then
    exec watch -n "${dssh_rlog_interval:-1}" cat "$latest"
  fi
  exec tail -F "$latest"
}

rlog_script_path() {
  local override="${dssh_rlog_script-}"
  if [[ -n "$override" ]]; then
    if [[ "$override" == /* ]]; then
      printf '%s\n' "$override"
    else
      printf '%s\n' "$script_dir/$override"
    fi
    return 0
  fi
  if [[ -f "$tool_dir/rlog.sh" ]]; then
    printf '%s\n' "$tool_dir/rlog.sh"
    return 0
  fi
  if [[ -f "$tool_dir/lib/rlog.sh" ]]; then
    printf '%s\n' "$tool_dir/lib/rlog.sh"
    return 0
  fi
  # Legacy portfolio layout during migration.
  if [[ -f "$script_dir/ops/diagnostics/rlog.sh" ]]; then
    printf '%s\n' "$script_dir/ops/diagnostics/rlog.sh"
    return 0
  fi
  printf '%s\n' "$tool_dir/rlog.sh"
}

rlog_dir() {
  local dir="${dssh_rlog_dir-}"
  if [[ -z "$dir" ]]; then
    dir="$script_dir/.dssh/rlog"
  elif [[ "$dir" != /* ]]; then
    dir="$script_dir/$dir"
  fi
  printf '%s\n' "$dir"
}

rlog_pid_file() {
  printf '%s\n' "$(rlog_dir)/rlog.pid"
}

rlog_is_running() {
  local pidfile pid script
  pidfile="$(rlog_pid_file)"
  if [[ -f "$pidfile" ]]; then
    pid="$(tr -d '[:space:]' < "$pidfile" 2>/dev/null || true)"
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      printf '%s\n' "$pid"
      return 0
    fi
  fi
  script="$(rlog_script_path)"
  pid="$(pgrep -f "$script" 2>/dev/null | head -n1 || true)"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    printf '%s\n' "$pid"
    return 0
  fi
  return 1
}

rlog_resolve_targets() {
  local raw="${dssh_rlog_containers-}"
  local alias name pairs=()
  raw="${raw// /}"
  if [[ -z "$raw" ]]; then
    return 0
  fi
  IFS=',' read -ra aliases <<< "$raw"
  for alias in "${aliases[@]}"; do
    [[ -z "$alias" ]] && continue
    if name="$(derive_app_name "$alias" 2>/dev/null)"; then
      pairs+=("$alias=$name")
    else
      pairs+=("$alias=$alias")
    fi
  done
  local IFS=','
  printf '%s\n' "${pairs[*]}"
}

rlog_stop() {
  local pidfile pid
  pidfile="$(rlog_pid_file)"
  pid=""
  if [[ -f "$pidfile" ]]; then
    pid="$(tr -d '[:space:]' < "$pidfile" 2>/dev/null || true)"
  fi
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    sleep 0.2
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
  fi
  pkill -f "$(rlog_script_path)" 2>/dev/null || true
  pkill -f "$script_dir/ops/diagnostics/host-watch.sh" 2>/dev/null || true
  while read -r pid rest; do
    [[ -z "$pid" ]] && continue
    case "$rest" in
      *'docker stats --format {{.Name}}|{{.CPUPerc}}'*)
        kill "$pid" 2>/dev/null || true
        ;;
    esac
  done < <(pgrep -af 'docker stats --format' 2>/dev/null || true)
  rm -f "$pidfile"
}

rlog_start() {
  local dir interval targets script pidfile
  dir="$(rlog_dir)"
  mkdir -p "$dir"
  interval="${dssh_rlog_interval:-1}"
  targets="$(rlog_resolve_targets)"
  script="$(rlog_script_path)"
  pidfile="$(rlog_pid_file)"
  if [[ ! -f "$script" ]]; then
    echo "rlog: script not found at $script" >&2
    return 1
  fi
  if [[ ! -x "$script" ]]; then
    chmod +x "$script" 2>/dev/null || true
  fi
  rlog_stop
  DSSH_RLOG_DIR="$dir" \
    DSSH_RLOG_INTERVAL="$interval" \
    DSSH_RLOG_TARGETS="$targets" \
    DSSH_RLOG_HISTORY_MAX_BYTES="${dssh_rlog_history_max:-16777216}" \
    DSSH_RLOG_HISTORY_KEEP_PLAIN="${dssh_rlog_history_keep:-3}" \
    DSSH_RLOG_ARCHIVE_MAX_BYTES="${dssh_rlog_archive_max:-268435456}" \
    nohup bash "$script" >>"$dir/rlog.stdout" 2>&1 &
  echo $! > "$pidfile"
  disown $! 2>/dev/null || true
  echo "rlog on  pid=$(tr -d '[:space:]' < "$pidfile")  dir=$dir  containers=${dssh_rlog_containers:-none}"
}

rlog_status() {
  local pid dir
  dir="$(rlog_dir)"
  if pid="$(rlog_is_running)"; then
    echo "rlog on  pid=$pid  dir=$dir  containers=${dssh_rlog_containers:-none}"
    if [[ -f "$dir/latest.txt" ]]; then
      echo "latest $(stat -c '%y' "$dir/latest.txt" 2>/dev/null || stat -f '%Sm' "$dir/latest.txt")"
    fi
  else
    echo "rlog off  dir=$dir  containers=${dssh_rlog_containers:-none}"
  fi
}

rlog_toggle() {
  local mode="${1-}"
  case "$mode" in
    on|start)
      rlog_start
      ;;
    off|stop)
      rlog_stop
      echo "rlog off"
      ;;
    status)
      rlog_status
      ;;
    "")
      if rlog_is_running >/dev/null; then
        rlog_stop
        echo "rlog off"
      else
        rlog_start
      fi
      ;;
    *)
      echo "Usage: dssh rlog [on|off|status]" >&2
      return 1
      ;;
  esac
}

bash_ident() {
  [[ "$1" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]
}

expand_tilde() {
  local path="$1"
  if [[ "$path" == "~" ]]; then
    printf '%s\n' "$HOME"
  elif [[ "$path" == "~/"* ]]; then
    printf '%s\n' "$HOME/${path:2}"
  else
    printf '%s\n' "$path"
  fi
}

# ssh -t user@host nano path — no scp, no local copy, no logging of file body.
rnano_remote() {
  local alias_name="${1-}"
  if [[ -z "$alias_name" ]]; then
    echo "Usage: dssh rnano <alias>" >&2
    echo "  Set <alias>_host and <alias>_path in .dsshrc (optional <alias>_key, <alias>_repo)." >&2
    return 1
  fi
  if ! bash_ident "$alias_name"; then
    echo "rnano: invalid alias '$alias_name'" >&2
    return 1
  fi

  local host_var="${alias_name}_host"
  local path_var="${alias_name}_path"
  local key_var="${alias_name}_key"
  local repo_var="${alias_name}_repo"
  local host="${!host_var-}"
  local rpath="${!path_var-}"
  local key="${!key_var-}"
  local repo="${!repo_var-}"

  if [[ -z "$host" || -z "$rpath" ]]; then
    echo "rnano: set ${alias_name}_host and ${alias_name}_path in .dsshrc" >&2
    return 1
  fi

  if [[ -z "$key" ]]; then
    key="$HOME/.ssh/id_ed25519"
  else
    key="$(expand_tilde "$key")"
  fi
  if [[ ! -f "$key" ]]; then
    echo "rnano: SSH key not found: $key" >&2
    return 1
  fi

  local -a ssh_cmd=(
    ssh
    -i "$key"
    -o IdentitiesOnly=yes
    -t
    "$host"
  )
  local quoted_path
  printf -v quoted_path '%q' "$rpath"

  # Interactive nano only — never cat/scp the remote file through this helper.
  "${ssh_cmd[@]}" "nano $quoted_path"
  local nano_rc=$?

  if [[ -n "$repo" ]]; then
    local backup_rel="${dssh_env_backup_relpath-}"
    if [[ -z "$backup_rel" ]]; then
      echo "rnano: ${alias_name}_repo set but dssh_env_backup_relpath is empty (skip backup)" >&2
    else
      local quoted_repo quoted_backup backup_path
      if [[ "$backup_rel" == /* ]]; then
        backup_path="$backup_rel"
      else
        backup_path="$repo/$backup_rel"
      fi
      printf -v quoted_repo '%q' "$repo"
      printf -v quoted_backup '%q' "$backup_path"
      # Soft: missing backup tool on the box must not fail the edit session.
      ssh -i "$key" -o IdentitiesOnly=yes "$host" \
        "if [[ -f $quoted_backup ]]; then bash $quoted_backup backup; else echo 'rnano: no backup script at $quoted_backup (skip)'; fi" \
        || echo "rnano: remote .env backup soft-failed (edit already saved)" >&2
    fi
  fi

  return "$nano_rc"
}

run_global_action() {
  local action_name="$1"
  local action_var="" override_cmd=""
  if bash_ident "$action_name"; then
    action_var="dssh_${action_name}_local"
    override_cmd="${!action_var-}"
  fi

  # Live publish: always ensure rlog is on, then run dssh_publish_local.
  if [[ "$action_name" == "publish" ]]; then
    shift
    if [[ -z "$override_cmd" ]]; then
      echo "publish: set dssh_publish_local in .dsshrc (path to your deploy script)" >&2
      return 1
    fi
    if rlog_is_running >/dev/null; then
      rlog_status
    else
      rlog_start
    fi
    run_local_shell "$(append_cli_args "$override_cmd" "$@")"
    return 0
  fi

  # Live stop must not use local-dev dssh_stop_local (that only kills dssh.image).
  if [[ "$action_name" == "stop" ]] && is_live_stack; then
    shift
    local hard=0 arg
    for arg in "$@"; do
      case "$arg" in
        --hard|-hard|hard|all|--all) hard=1 ;;
      esac
    done
    if [[ "$hard" != "1" ]]; then
      echo "LIVE: refusing full stop (would drop the whole live stack)." >&2
      echo "  One service:  dssh <target> stop" >&2
      echo "  Hard cutover: dssh stop --hard" >&2
      return 1
    fi
    live_stop_hard
    return 0
  fi

  if [[ -n "$override_cmd" ]]; then
    shift
    if [[ "$action_name" == "stop" ]]; then
      acquire_docker_lock
    fi
    run_local_shell "$(append_cli_args "$override_cmd" "$@")"
    return 0
  fi

  if [[ "$action_name" == "stop" ]]; then
    local ids id
    acquire_docker_lock
    ids="$(dssh_app_ids)"
    if [[ -n "$ids" ]]; then
      # shellcheck disable=SC2086
      for id in $ids; do
        remove_container "$id"
      done
    fi
    compose --profile dashboards stop postgres redis opensearch opensearch-dashboards 2>/dev/null \
      || compose stop postgres redis opensearch
    echo "Stopped dssh app containers and compose infra services."
    return 0
  fi

  if [[ "$action_name" == "rlog" ]]; then
    shift
    rlog_toggle "${1-}"
    return 0
  fi

  if [[ "$action_name" == "rnano" ]]; then
    shift
    rnano_remote "${1-}"
    return $?
  fi

  if [[ "$action_name" == "gpu-setup" ]]; then
    gpu_setup
    return $?
  fi

  if [[ "$action_name" == "gpu-probe" ]]; then
    gpu_probe_done=0
    detect_docker_gpu
    if [[ ${#gpu_args[@]} -gt 0 ]]; then
      echo "dssh gpu-probe: --gpus all"
    else
      echo "dssh gpu-probe: cpu-only"
    fi
    return 0
  fi

  if [[ "$action_name" == "status" || "$action_name" == "ps" ]]; then
    show_status
    return 0
  fi

  if [[ "$action_name" == "health" ]]; then
    if is_live_stack; then
      live_health
    else
      show_local_status
      echo
      echo "(health probes are live-oriented; local shown as status above)"
    fi
    return 0
  fi

  if [[ "$action_name" == "migrate" ]]; then
    if is_live_stack; then
      live_migrate
      return 0
    fi
    shift
    local migrate_target="${dssh_migrate_target:-backend}"
    exec "$tool_bin" "$migrate_target" migrate "$@"
  fi

  if [[ "$action_name" == "logs" ]]; then
    local target="${2-}"
    if [[ "$target" == "rlog" ]]; then
      follow_rlog_logs
      return $?
    fi
    if is_live_stack; then
      follow_live_logs "$target"
      return 0
    fi
    if [[ -n "$target" ]]; then
      docker logs -f "$(derive_app_name "$target")"
      return 0
    fi
    local ids
    ids="$(docker ps -q --filter "label=dssh.image")"
    if [[ -z "$ids" ]]; then
      echo "No dssh app containers are running."
      return 0
    fi
    # shellcheck disable=SC2086
    docker logs -f $ids
    return 0
  fi

  return 1
}

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

if [[ "$1" == "help" || "$1" == "-h" || "$1" == "--help" ]]; then
  usage
  exit 0
fi

run_as_global=0
if [[ "$1" == "stop" || "$1" == "status" || "$1" == "ps" || "$1" == "health" \
  || "$1" == "logs" || "$1" == "rlog" || "$1" == "rnano" || "$1" == "publish" \
  || "$1" == "migrate" || "$1" == "gpu-setup" || "$1" == "gpu-probe" ]]; then
  run_as_global=1
elif bash_ident "$1"; then
  global_action_var="dssh_${1}_local"
  if [[ -n "${!global_action_var-}" ]]; then
    run_as_global=1
  fi
fi
if [[ "$run_as_global" == "1" ]]; then
  run_global_action "$@"
  exit 0
fi

# Resolve compose-ish aliases from .dsshrc (<target>_aliases).
target_name="$(resolve_target_alias "$1")"
shift

target_path_var="$target_name"
target_path="${!target_path_var-}"

if [[ -z "$target_path" ]]; then
  if [[ -d "$script_dir/$target_name" ]]; then
    target_path="$target_name"
  else
    echo "Unknown target: $target_name" >&2
    usage
    exit 1
  fi
fi

dockerfile_var="${target_name}_dockerfile"
context_var="${target_name}_context"
image_var="${target_name}_image"
workdir_var="${target_name}_workdir"
mount_node_modules_var="${target_name}_mount_node_modules"

target_abs_path="$(resolve_path "$target_path")"
dockerfile_path="${!dockerfile_var-}"
if [[ -n "$dockerfile_path" ]]; then
  dockerfile_path="$(resolve_path "$dockerfile_path")"
else
  dockerfile_path="$target_abs_path/Dockerfile"
fi

if [[ ! -f "$dockerfile_path" ]]; then
  echo "Dockerfile not found for target '$target_name': $dockerfile_path" >&2
  exit 1
fi

context_path="${!context_var-}"
if [[ -n "$context_path" ]]; then
  context_path="$(resolve_path "$context_path")"
else
  context_path="$script_dir"
fi

image_name="${!image_var-}"
if [[ -z "$image_name" ]]; then
  image_name="dssh-${target_name}"
fi

workdir_path="${!workdir_var-}"
if [[ -z "$workdir_path" ]]; then
  workdir_path="$(parse_workdir "$dockerfile_path")"
fi
if [[ -z "$workdir_path" ]]; then
  workdir_path="/app"
fi

mount_node_modules="${!mount_node_modules_var-1}"
app_name="$(derive_app_name "$target_name")"

# LIVE: manage compose prod services from .dsshrc. Never docker-run npm-dev
# against the same names — that would fight the live stack.
if is_live_stack; then
  live_svc=""
  if ! live_svc="$(live_compose_service "$target_name")"; then
    if [[ "${1-}" == "stop" || "${1-}" == "start" || "${1-}" == "restart" || "${1-}" == "build" ]]; then
      echo "No live compose service for target '$target_name' (set ${target_name}_service)." >&2
      exit 1
    fi
  fi

  if [[ $# -eq 0 ]]; then
    local_cname="$(live_container_name "$target_name" 2>/dev/null || true)"
    if [[ -z "$local_cname" ]]; then
      echo "No live container for target '$target_name'." >&2
      exit 1
    fi
    if use_tty; then
      docker exec -it "$local_cname" sh -lc 'command -v bash >/dev/null && exec bash || exec sh'
    else
      docker exec "$local_cname" sh -lc 'command -v bash >/dev/null && exec bash || exec sh'
    fi
    exit 0
  fi

  live_action="$1"
  shift
  skip_build=0
  live_args=()
  for arg in "$@"; do
    case "$arg" in
      -nobuild|--nobuild) skip_build=1 ;;
      *) live_args+=("$arg") ;;
    esac
  done
  set -- "${live_args[@]+"${live_args[@]}"}"

  case "$live_action" in
    build)
      acquire_docker_lock
      compose_live build "$live_svc" "$@"
      exit 0
      ;;
    start|restart)
      maybe_run_start_preflight "$target_name"
      live_restart_service "$live_svc" "$skip_build"
      exit 0
      ;;
    stop)
      live_stop_service "$live_svc"
      exit 0
      ;;
    migrate)
      if [[ -n "${dssh_live_migrate_service-}" && "$live_svc" != "$dssh_live_migrate_service" ]]; then
        echo "migrate is only for compose service '$dssh_live_migrate_service' on live." >&2
        exit 1
      fi
      live_migrate
      exit 0
      ;;
    logs)
      follow_live_logs "$target_name"
      exit 0
      ;;
    *)
      live_action_local_var="${target_name}_${live_action}_local"
      live_action_container_var="${target_name}_${live_action}"
      live_action_local_cmd="${!live_action_local_var-}"
      live_action_container_cmd="${!live_action_container_var-}"
      if [[ -n "$live_action_container_cmd" ]]; then
        acquire_docker_lock
        # One-shot via compose run — does not replace the running service.
        compose_live run --rm --no-deps "$live_svc" \
          sh -lc "$(append_cli_args "$live_action_container_cmd" "$@")"
        exit 0
      fi
      if [[ -n "$live_action_local_cmd" ]]; then
        run_local_shell "$(append_cli_args "$live_action_local_cmd" "$@")"
        exit 0
      fi
      # Treat remaining argv as a command inside the running container.
      local_cname="$(live_container_name "$target_name")"
      if ! docker inspect --type container "$local_cname" >/dev/null 2>&1; then
        echo "Live container $local_cname is not running." >&2
        exit 1
      fi
      if use_tty; then
        docker exec -it "$local_cname" "$live_action" "$@"
      else
        docker exec "$local_cname" "$live_action" "$@"
      fi
      exit 0
      ;;
  esac
fi

if [[ $# -eq 0 ]]; then
  interactive_mode=1
  set -- "$(detect_shell "$image_name")"
else
  interactive_mode=0
fi

if [[ "$1" == "build" ]]; then
  shift
  build_image "$image_name" "$dockerfile_path" "$context_path" "$@"
  exit 0
fi

if [[ "$1" == "stop" ]]; then
  stop_target_start_container "$app_name" "$target_name"
  exit 0
fi

if [[ "$1" == "restart" ]]; then
  shift
  # Keep the old container up during the image rebuild, then start replaces it.
  exec "$tool_bin" "$target_name" start "$@"
fi

# Local parity with live `<t> logs` and global `logs <t>`. Without this, a bare
# `logs` argv hits the node image entrypoint as `node logs` → MODULE_NOT_FOUND
# /app/logs (common typo after `<t> restart`).
if [[ "$1" == "logs" ]]; then
  docker logs -f "$app_name"
  exit 0
fi

action_name="$1"
action_local_var="${target_name}_${action_name}_local"
action_container_var="${target_name}_${action_name}"
action_attach_var="${target_name}_${action_name}_attach"
action_detached_var="${target_name}_${action_name}_detached"
action_local_cmd="${!action_local_var-}"
action_container_cmd="${!action_container_var-}"
action_attach="${!action_attach_var-1}"
action_detached="${!action_detached_var-0}"

if [[ "$action_detached" == "1" ]]; then
  action_attach=0
fi

if [[ "$action_name" == "start" ]]; then
  maybe_run_start_preflight "$target_name"
fi

if [[ -n "$action_local_cmd" || -n "$action_container_cmd" ]]; then
  shift

  skip_build=0
  action_args=()
  for arg in "$@"; do
    case "$arg" in
      -nobuild|--nobuild)
        skip_build=1
        ;;
      *)
        action_args+=("$arg")
        ;;
    esac
  done
  set -- "${action_args[@]+"${action_args[@]}"}"

  acquire_docker_lock

  if [[ -n "$action_container_cmd" ]]; then
    if [[ "$action_name" == "start" && "$skip_build" != "1" ]]; then
      echo "Building $image_name before start (pass -nobuild to skip)..."
      build_image "$image_name" "$dockerfile_path" "$context_path"
    elif ! docker image inspect "$image_name" >/dev/null 2>&1; then
      build_image "$image_name" "$dockerfile_path" "$context_path"
    fi
  fi

  if [[ -n "$action_local_cmd" ]]; then
    run_local_shell "$(append_cli_args "$action_local_cmd" "$@")"
  fi

  if [[ -n "$action_container_cmd" ]]; then
    action_container_name="$(container_name_for "$app_name" "$action_name")"
    remove_container "$action_container_name"
    if [[ "$action_name" == "start" ]]; then
      remove_container "dssh-${target_name}-start"
    fi
    run_container_shell "$image_name" "$context_path" "$workdir_path" "$action_attach" "$action_container_name" "$mount_node_modules" "$action_detached" "$(append_cli_args "$action_container_cmd" "$@")"
    exit 0
  fi

  exit 0
fi

if ! docker image inspect "$image_name" >/dev/null 2>&1; then
  build_image "$image_name" "$dockerfile_path" "$context_path"
fi

run_container "$image_name" "$context_path" "$workdir_path" "$interactive_mode" "" "$mount_node_modules" "0" "$@"